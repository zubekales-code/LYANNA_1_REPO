# Zkopíruj jako `.env` a vyplň. Soubor .env je v .gitignore a NIKDY
# nepatří do repozitáře.
#
# V GitHub Actions se tyhle hodnoty nastavují jinde:
#   Settings -> Secrets and variables -> Actions -> New repository secret

# Supabase — projekt Lyanna
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# SERVISNÍ klíč (service_role), ne anon/publishable.
# Obchází RLS, takže patří výhradně sem a do GitHub Secrets.
# Do frontendu se nikdy nedostane — ten zůstává u publishable klíče.
SUPABASE_SERVICE_KEY=

# OpenAI
OPENAI_API_KEY=

# Volitelné. Bez klíče se používá volný endpoint Jina Readeru.
# Založ, až se objeví rate-limiting.
JINA_API_KEY=
